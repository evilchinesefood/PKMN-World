#!/usr/bin/env bash
# Local fast gate. Install with:  test/overworld/hooks/install.sh
#
# The Makefile, test/overworld/ValidateScripts.py and .github/workflows/Check.yml all refer to this
# hook as an existing gate, but git does not clone hooks -- so on a fresh checkout it silently
# was not there and nothing ran until CI. Hence a tracked copy plus an installer.
#
# These five scans are the only automated thing standing between a bad data edit and a crash
# that only shows up in play: a disabled-species reference, a bare-integer script pointer, a
# bad overworld-Pokemon placement, or an NPC wearing the wrong sprite all BUILD and BOOT clean,
# then fault (or just read as broken) later. They are
# source-only and take seconds -- no ROM build required.
#
# Invoked directly rather than through `make validate`: that target is not in RULES_NO_SCAN, so
# going through make would trigger the full dependency scan for a check that reads only tracked
# data files. Same reasoning as the Check.yml validate job.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-push: python3 not found, cannot run content validation" >&2
  exit 1
fi

fail=0
run() {
  echo "pre-push: $1"
  shift
  if ! python3 "$@"; then fail=1; fi
}

run "Gen 1-3 species rules"          test/overworld/ValidateGen13.py
run "Event-script pointer arguments" test/overworld/ValidateScripts.py
run "Overworld-Pokemon placements"   test/overworld/ValidateOwMonPlacements.py
run "Map object-event consistency"   test/overworld/ValidateMapEvents.py
run "Map metatile bounds"            test/overworld/ValidateMetatileBounds.py
run "Cleared-obstacle table"         test/overworld/GenObstacleTable.py --check
run "Save-format constants"          test/overworld/SavePatch.py --check
run "Animated doors registered"      test/overworld/ValidateDoorAnims.py --max 0
run "Tileset palette array bounds"   test/overworld/ValidateTilesetPalettes.py
run "Celio first-gift bag-full retry" test/overworld/ValidateCelioGifts.py
run "Greedy exclusive-choice gifts"   test/overworld/ValidateGreedyGifts.py
run "Region map icon positions"       test/overworld/ValidateRegionMap.py
run "Lance Rocket HQ multi battle"    test/overworld/ValidateLanceMultiBattle.py
run "Registered zone structures"     test/overworld/ValidateZoneStructure.py

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'EOF'

pre-push: content validation FAILED -- push aborted.
Fix the reports above, or re-run with --no-verify if you are certain.
Note that .github/workflows/Check.yml mirrors these scans, so --no-verify only defers it.
EOF
  exit 1
fi

echo "pre-push: content validation OK"
exit 0
