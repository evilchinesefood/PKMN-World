static const struct StoryObjective *ResolveKanto(void)
{
    u16 lab = V(VAR_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB);
    u16 ship = V(VAR_MAP_SCENE_VERMILION_CITY);
    // The captain advances scene 1 only after CUT enters the BAG; 2/3 are
    // successive departure scenes. A sailed ship makes the captain unavailable.
    bool32 receivedCut = F(FLAG_GOT_HM01) || (ship >= 1 && ship <= 3);
    bool32 hasBadge = B(REGION_KANTO, 0) || B(REGION_KANTO, 1)
        || B(REGION_KANTO, 2) || B(REGION_KANTO, 3) || B(REGION_KANTO, 4)
        || B(REGION_KANTO, 5) || B(REGION_KANTO, 6) || B(REGION_KANTO, 7);

    if (F(FLAG_KANTO_CHAMPION))
        return &sKantoChampion;
    // Badge evidence prevents stale opening scenes trapping migrated saves.
    if (!hasBadge && lab < 6)
    {
        if (lab < 3)
            return &sKantoStarter;
        if (lab == 3)
            return &sKantoRival;
        if (lab == 4)
            return &sKantoParcel;
        return &sKantoDeliverParcel;
    }
    if (!B(REGION_KANTO, 0))
        return &sKantoBrock;
    if (!B(REGION_KANTO, 1) && !F(FLAG_GOT_FOSSIL_FROM_MT_MOON))
        return &sKantoMtMoon;
    if (!receivedCut && !F(FLAG_GOT_SS_TICKET))
        return F(FLAG_HELPED_BILL_IN_SEA_COTTAGE) ? &sKantoTicket : &sKantoBill;
    if (!B(REGION_KANTO, 1))
        return &sKantoMisty;
    if (!receivedCut)
        return &sKantoCut;
    if (!B(REGION_KANTO, 2))
        return &sKantoSurge;
    // Fuji's rescue proves tower access even if old reward flags are missing.
    if (!F(FLAG_RESCUED_MR_FUJI))
    {
        if (V(VAR_MAP_SCENE_POKEMON_TOWER_6F) == 0)
        {
            if (!F(FLAG_HIDE_CELADON_ROCKETS))
            {
                if (!F(FLAG_OPENED_ROCKET_HIDEOUT))
                    return &sKantoHideout;
                if (!F(FLAG_CAN_USE_ROCKET_HIDEOUT_LIFT))
                    return &sKantoLiftKey;
                return &sKantoHideoutBoss;
            }
            if (!F(FLAG_HIDE_SILPH_SCOPE))
                return &sKantoScope;
            return &sKantoTower;
        }
        return &sKantoFuji;
    }
    if (!F(FLAG_GOT_POKE_FLUTE))
        return &sKantoFlute;
    if (!B(REGION_KANTO, 3))
        return &sKantoErika;
    if (!F(FLAG_GOT_HM03))
        return &sKantoSurf;
    if (!B(REGION_KANTO, 4))
        return &sKantoKoga;
    if (!F(FLAG_GOT_HM04))
        return F(FLAG_HIDE_SAFARI_ZONE_WEST_GOLD_TEETH) ? &sKantoStrength : &sKantoTeeth;
    // Completion beats stale prerequisite vars; both Silph scene and its explicit
    // Rocket departure flag are regional completion evidence.
    if (!V(VAR_MAP_SCENE_SILPH_CO_11F) && !F(FLAG_HIDE_SAFFRON_ROCKETS))
    {
        if (!V(VAR_MAP_SCENE_ROUTE5_ROUTE6_ROUTE7_ROUTE8_GATES))
            return F(FLAG_GOT_TEA) ? &sKantoSaffronGate : &sKantoTea;
        if (!F(FLAG_HIDE_SILPH_CO_5F_CARD_KEY))
            return &sKantoCardKey;
        return &sKantoSilph;
    }
    if (!B(REGION_KANTO, 5))
        return &sKantoSabrina;
    if (!B(REGION_KANTO, 6))
        return F(FLAG_HIDE_POKEMON_MANSION_B1F_SECRET_KEY) ? &sKantoBlaine : &sKantoSecretKey;
    if (!B(REGION_KANTO, 7))
        return &sKantoGiovanni;
    return &sKantoLeague;
}

static const struct StoryObjective *ResolveKantoOptional(void)
{
    u16 celio = V(VAR_MAP_SCENE_ONE_ISLAND_POKEMON_CENTER_1F);
    u16 lostelle = V(VAR_MAP_SCENE_TWO_ISLAND_JOYFUL_GAME_CORNER);

    // Scene 3 is the completed first visit, not a request for a future gem.
    if (celio >= 6)
        return NULL;
    if (celio >= 4)
    {
        if (F(FLAG_RECOVERED_SAPPHIRE))
            return &sKantoDeliverSapphire;
        if (celio == 4)
            return F(FLAG_GOT_RUBY) ? &sKantoDeliverRuby : &sKantoRuby;
        if (F(FLAG_LEARNED_YES_NAH_CHANSEY))
            return &sKantoWarehouse;
        if (!V(VAR_MAP_SCENE_ICEFALL_CAVE_BACK))
            return &sKantoIcefall;
        return &sKantoDottedHole;
    }
    if (celio == 3)
        return NULL;
    if (celio == 0 && lostelle == 0 && !F(FLAG_RESCUED_LOSTELLE))
        return NULL;
    if (celio == 2)
    {
        if (F(FLAG_NO_ROOM_FOR_JOYFUL_GAME_CORNER_MOON_STONE)
            && !F(FLAG_GOT_MOON_STONE_FROM_JOYFUL_GAME_CORNER))
            return &sKantoMoonStone;
        return &sKantoReturnBill;
    }
    if (F(FLAG_RESCUED_LOSTELLE) || lostelle >= 2)
        return &sKantoMeteorite;
    // Inventory can identify a missed prerequisite, never quest completion.
    if (!I(ITEM_TRI_PASS) || !I(ITEM_METEORITE))
        return &sKantoSeviiGifts;
    if (lostelle == 0)
        return &sKantoSeviiDelivery;
    if (V(VAR_MAP_SCENE_THREE_ISLAND) < 4)
        return &sKantoBikers;
    return &sKantoLostelle;
}
