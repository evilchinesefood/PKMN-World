static const struct StoryObjective *ResolveJohto(void)
{
    u16 lab = V(VAR_NEWBARKTOWN_LABSTATE);
    u16 azalea = V(VAR_AZALEA_TOWN_STATE);
    u16 farfetchd = V(VAR_ILEX_FOREST_FARFETCHD);
    u16 goldenrod = V(VAR_GOLDENROD_CITY_STATE);
    u16 mahogany = V(VAR_MAHOGANY_TOWN_STATE);
    u16 olivine = V(VAR_OLIVINE_CITY_STATE);
    u16 theater = V(VAR_ECRUTEAK_CITY_THEATER);
    u16 blackthorn = V(VAR_BLACKTHORN_CITY_STATE);
    u8 i;
    bool32 anyBadge = FALSE;
    bool32 laterBadge = FALSE;
    bool32 allBadges = TRUE;
    bool32 pastViolet;
    bool32 pastIlex;
    bool32 pastOpening;

    // Champion is regional. Generic GAME_CLEAR and held tickets are ignored.
    if (F(FLAG_JOHTO_CHAMPION))
        return lab < 11 ? &sJohtoTicket : &sJohtoPostgame;

    for (i = 0; i < 8; i++)
    {
        if (B(REGION_JOHTO, i))
        {
            anyBadge = TRUE;
            if (i > 0)
                laterBadge = TRUE;
        }
        else
            allBadges = FALSE;
    }

    // Explicit late scenes remain useful on migrated saves with stale early vars.
    // All eight actual badge bits do not require reconstructing old cutscenes.
    if (allBadges)
    {
        if (V(VAR_LEAGUE_STATE) >= 6)
            return &sJohtoHall;
        if (V(VAR_LEAGUE_STATE) >= 2)
            return &sJohtoLeagueNext;
        if (V(VAR_LEAGUE_STATE) == 1)
            return &sJohtoLeagueEntry;
        // The theater writes lab state 9 before its state-7 departure, but an
        // older/stale invitation must not rewind the stronger local scene.
        if (theater >= 8)
            return &sJohtoLeague;
        if (theater == 7)
        {
            if (V(VAR_COMPLETED_LUGIA) == 2)
                return &sJohtoWhirl;
            if (V(VAR_COMPLETED_HO_OH) == 2)
                return &sJohtoTin;
            return &sJohtoLeagueCheck;
        }
        if (theater >= 4 && theater <= 6)
            return &sJohtoKimono;
        if (blackthorn == 3)
            return &sJohtoDenExit;
        if (blackthorn == 4)
            return &sJohtoElmCall;
        if (lab == 7)
            return &sJohtoElmGift;
        if (lab == 8)
            return &sJohtoKimono;
        // ReceptionGate requires the theater's final scene, in addition to
        // all badges. Badge possession alone cannot complete this prerequisite.
        return theater >= 8 ? &sJohtoLeague : &sJohtoLeagueCheck;
    }

    pastViolet = laterBadge || azalea >= 3 || farfetchd >= 3
        || goldenrod >= 3 || theater >= 3 || olivine >= 3
        || mahogany >= 2 || blackthorn >= 2;
    pastOpening = anyBadge || pastViolet || V(VAR_VIOLET_CITY_STATE) >= 5
        || V(VAR_SPROUT_TOWER) >= 1 || F(FLAG_JOHTO_ADVENTURE_STARTED);
    if (!pastOpening && lab < 5)
    {
        if (lab == 4 || V(VAR_CHERRYGROVE_CITY_STATE) >= 2)
            return &sJohtoReturnElm;
        if (F(FLAG_JOHTO_STARTER_CHOSEN) || lab >= 2)
            return &sJohtoMrPokemon;
        return lab == 1 ? &sJohtoStarter : &sJohtoElm;
    }
    if (!anyBadge && !pastViolet && lab == 5)
        return &sJohtoFirstBalls;

    // Route 32 checks Silver's tower scene, Falkner and the aide's Egg.
    // FLASH is shared with Hoenn and is neither the scene nor a travel gate.
    if (!pastViolet && V(VAR_SPROUT_TOWER) == 0 && !F(FLAG_HIDE_SPROUT_TOWER_SILVER))
        return &sJohtoSprout;
    if (!B(REGION_JOHTO, 0))
        return &sJohtoFalkner;
    if (!pastViolet && V(VAR_VIOLET_CITY_STATE) < 5)
    {
        if (!F(FLAG_RECEIVED_TOGEPI_EGG))
            return &sJohtoEgg;
        // The Egg flag is set before the aide's bag-checked second gift. His
        // local departure flag is the successful tail, not held EXP SHARE.
        if (V(VAR_VIOLET_CITY_STATE) >= 4 && !F(FLAG_HIDE_VIOLET_CITY_AIDE))
            return &sJohtoVioletGift;
    }

    pastIlex = farfetchd >= 3 || azalea >= 7 || goldenrod >= 3
        || B(REGION_JOHTO, 2) || B(REGION_JOHTO, 3)
        || B(REGION_JOHTO, 4) || B(REGION_JOHTO, 5)
        || B(REGION_JOHTO, 6) || B(REGION_JOHTO, 7);
    if (!B(REGION_JOHTO, 1) && !pastIlex && azalea < 4)
    {
        if (azalea == 3)
            return &sJohtoKurtReturn;
        // Kurt's north-facing exit sets this flag but omits state 2.
        if (azalea == 2 || F(FLAG_HIDE_AZALEA_TOWN_WELL_ROCKET))
            return &sJohtoWell;
        return &sJohtoKurt;
    }
    if (!B(REGION_JOHTO, 1))
        return &sJohtoBugsy;
    if (!pastIlex)
    {
        if (azalea == 5)
            return &sJohtoRival;
        return farfetchd == 2 ? &sJohtoIlexCut : &sJohtoIlex;
    }
    if (!B(REGION_JOHTO, 2))
        return goldenrod == 3 || goldenrod == 4 ? &sJohtoWhitneyBadge : &sJohtoWhitney;

    if (!B(REGION_JOHTO, 3))
    {
        if (!F(FLAG_HIDE_SUDOWOODO) && theater < 3 && olivine < 3 && mahogany < 2
            && !B(REGION_JOHTO, 4) && !B(REGION_JOHTO, 5) && !B(REGION_JOHTO, 6))
            return F(FLAG_RECEIVED_SQUIRTBOTTLE) && I(ITEM_SQUIRT_BOTTLE)
                ? &sJohtoSudo : &sJohtoBottle;
        if (!F(FLAG_RELEASED_BEASTS))
            return &sJohtoBurned;
        return &sJohtoMorty;
    }

    // Follow an already active eastern route even if Chuck/Jasmine are pending.
    // The Radio Tower is triggered by Pryce, not by a total badge count.
    if (goldenrod >= 6 && goldenrod < 11)
    {
        if (goldenrod == 6)
            return &sJohtoRadio;
        if (goldenrod <= 8)
            return &sJohtoUnderground;
        // The Director's Card Key has no local receipt flag. Possession of the
        // Kanto key cannot establish his rescue: show both actionable steps.
        return goldenrod == 9 ? &sJohtoRadioRescue : &sJohtoRadioDirector;
    }
    if (mahogany >= 2 && mahogany < 14)
    {
        if (mahogany <= 3)
            return &sJohtoLance;
        if (mahogany == 4)
            return &sJohtoShop;
        if (mahogany < 7)
            return &sJohtoHideout;
        if (mahogany < 9)
            return V(VAR_ROCKET_PASSWORD) == 2 ? &sJohtoHideoutDoor : &sJohtoHideoutPasswords;
        if (mahogany < 12)
            return &sJohtoHideoutMurkrow;
        if (mahogany == 12)
            return &sJohtoHideoutRoom;
        return V(VAR_ELECTRODES_FAINTED) >= 3 ? &sJohtoWhirlpool : &sJohtoGenerator;
    }
    // Pharmacists set state 4 even when giveitem fails. Medicine possession is
    // only a prerequisite under a known local scene, never proof of healing.
    if (olivine >= 3 && olivine < 5 && !F(FLAG_AMPHAROS_HEALED)
        && !B(REGION_JOHTO, 5))
        return I(ITEM_SECRET_POTION) ? &sJohtoDeliver : &sJohtoMedicine;

    if (theater < 3 && !B(REGION_JOHTO, 4) && !B(REGION_JOHTO, 5) && mahogany < 14)
        return theater == 2 ? &sJohtoSurf : &sJohtoTheater;
    if (!B(REGION_JOHTO, 4))
        return &sJohtoChuck;
    if (!B(REGION_JOHTO, 5))
    {
        if (olivine < 5 && !F(FLAG_AMPHAROS_HEALED))
            return &sJohtoLighthouse;
        return &sJohtoJasmine;
    }
    if (mahogany < 14 && goldenrod < 11)
        return &sJohtoRage;
    if (!B(REGION_JOHTO, 6))
        return &sJohtoPryce;
    if (goldenrod < 11 && mahogany < 17)
        return &sJohtoRadioCall;
    if (blackthorn == 2)
        return &sJohtoDen;
    return &sJohtoClair;
}

static const struct StoryObjective *ResolveJohtoOptional(void)
{
    u16 azalea = V(VAR_AZALEA_TOWN_STATE);

    if (F(FLAG_CAUGHT_CELEBI))
        return NULL;
    // Item locations/hide flags and GS Ball ownership do not prove the chain
    // started. Kurt's accepted handoff is the first unambiguous saved scene.
    if (azalea == 8)
        return &sJohtoGsKurt;
    if (azalea == 9)
        return &sJohtoGsShrine;
    // The encounter advances to 10 even after a failed catch. The retry object
    // is explicitly hidden until this region's Champion flag is set.
    if (azalea >= 10)
        return F(FLAG_JOHTO_CHAMPION) ? &sJohtoCelebiRetry : &sJohtoCelebiLater;
    return NULL;
}
