static const struct StoryObjective *ResolveHoenn(void)
{
    // Later regional scenes are durable evidence even in migrated saves whose
    // earlier variables were not copied. Shared HMs and items are not evidence.
    bool32 crisis = F(FLAG_KYOGRE_ESCAPED_SEAFLOOR_CAVERN)
        || V(VAR_SOOTOPOLIS_CITY_STATE) != 0
        || F(FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE);
    bool32 ocean = crisis || F(FLAG_TEAM_AQUA_ESCAPED_IN_SUBMARINE)
        || F(FLAG_MET_TEAM_AQUA_HARBOR)
        || F(FLAG_GROUDON_AWAKENED_MAGMA_HIDEOUT)
        || F(FLAG_DEFEATED_MAGMA_SPACE_CENTER)
        || V(VAR_MT_PYRE_STATE) != 0;
    bool32 east = ocean || V(VAR_WEATHER_INSTITUTE_STATE) != 0
        || F(FLAG_RECEIVED_DEVON_SCOPE) || B(REGION_HOENN, 5);
    bool32 middle = east || F(FLAG_DEFEATED_EVIL_TEAM_MT_CHIMNEY)
        || F(FLAG_MET_ARCHIE_METEOR_FALLS)
        || V(VAR_METEOR_FALLS_STATE) != 0
        || B(REGION_HOENN, 3) || B(REGION_HOENN, 4);
    bool32 issued = F(FLAG_RECEIVED_POKENAV) || V(VAR_DEVON_CORP_3F_STATE) != 0;
    bool32 early = middle || issued || B(REGION_HOENN, 0)
        || F(FLAG_RETURNED_DEVON_GOODS) || F(FLAG_RECOVERED_DEVON_GOODS)
        || F(FLAG_DEVON_GOODS_STOLEN);

    if (F(FLAG_HOENN_CHAMPION))
        return &sHoennComplete;
    if (!early)
    {
        if (!F(FLAG_RECEIVED_POKEDEX_FROM_BIRCH) && V(VAR_BIRCH_LAB_STATE) < 5)
        {
            if (V(VAR_BIRCH_LAB_STATE) >= 4 || F(FLAG_DEFEATED_RIVAL_ROUTE103))
                return &sHoennPokedex;
            if (V(VAR_BIRCH_LAB_STATE) >= 3)
                return &sHoennRoute103;
            if (V(VAR_BIRCH_LAB_STATE) >= 2 || F(FLAG_RESCUED_BIRCH))
                return &sHoennStarterLab;
            if (!F(FLAG_SET_WALL_CLOCK))
                return &sHoennClock;
            if (V(VAR_LITTLEROOT_RIVAL_STATE) < 3 && V(VAR_LITTLEROOT_TOWN_STATE) == 0)
                return &sHoennMeetRival;
            return &sHoennRescueBirch;
        }
        if (V(VAR_PETALBURG_GYM_STATE) < 2)
            return &sHoennPetalburg;
        if (V(VAR_PETALBURG_WOODS_STATE) == 0)
            return &sHoennWoods;
    }
    if (!B(REGION_HOENN, 0))
        return &sHoennRoxanne;
    if (!middle && !issued)
    {
        if (!F(FLAG_RECOVERED_DEVON_GOODS))
            return &sHoennDevonRecover;
        if (!F(FLAG_RETURNED_DEVON_GOODS))
            return &sHoennDevonReturn;
        return &sHoennDevonPresident;
    }
    // Deliveries are independent; explicitly issued work remains outstanding.
    if (issued && !F(FLAG_DELIVERED_STEVEN_LETTER))
        return &sHoennDevonSteven;
    if (!B(REGION_HOENN, 1))
        return &sHoennBrawly;
    if (issued && !F(FLAG_DELIVERED_DEVON_GOODS))
        return F(FLAG_DOCK_REJECTED_DEVON_GOODS) ? &sHoennDevonStern : &sHoennDevonDock;
    if (!middle && V(VAR_ROUTE110_STATE) == 0)
        return &sHoennRoute110;
    if (!B(REGION_HOENN, 2))
    {
        if (!middle && !F(FLAG_DEFEATED_WALLY_MAUVILLE))
            return &sHoennWallyMauville;
        return &sHoennWattson;
    }
    if (!middle)
    {
        if (!F(FLAG_RECEIVED_HM_ROCK_SMASH) && !I(ITEM_HM_ROCK_SMASH))
            return &sHoennRockSmash;
        if (!F(FLAG_MET_ARCHIE_METEOR_FALLS) && V(VAR_METEOR_FALLS_STATE) == 0)
            return &sHoennMeteorFalls;
    }
    if (!east && !F(FLAG_DEFEATED_EVIL_TEAM_MT_CHIMNEY))
        return &sHoennMtChimney;
    if (!B(REGION_HOENN, 3))
        return &sHoennFlannery;
    if (!B(REGION_HOENN, 4))
        return &sHoennNorman;
    if (!east)
    {
        if (!F(FLAG_RECEIVED_HM_SURF) && !I(ITEM_HM_SURF))
            return &sHoennSurf;
        return &sHoennWeatherInstitute;
    }
    if (!ocean)
    {
        if (V(VAR_WEATHER_INSTITUTE_STATE) != 0 && !F(FLAG_RECEIVED_CASTFORM))
            return &sHoennCastform;
        if (V(VAR_ROUTE119_STATE) == 0)
            return &sHoennRoute119;
        if (!F(FLAG_RECEIVED_DEVON_SCOPE))
            return &sHoennDevonScope;
    }
    if (!B(REGION_HOENN, 5))
        return &sHoennWinona;
    if (!ocean)
        return &sHoennMtPyre;
    if (!crisis)
    {
        if (!F(FLAG_GROUDON_AWAKENED_MAGMA_HIDEOUT)
            && !F(FLAG_MET_TEAM_AQUA_HARBOR)
            && !F(FLAG_TEAM_AQUA_ESCAPED_IN_SUBMARINE)
            && !F(FLAG_DEFEATED_MAGMA_SPACE_CENTER))
        {
            if (!F(FLAG_RECEIVED_HM_STRENGTH) && !I(ITEM_HM_STRENGTH))
                return &sHoennStrength;
            return &sHoennMagmaHideout;
        }
        if (!F(FLAG_MET_TEAM_AQUA_HARBOR) && !F(FLAG_TEAM_AQUA_ESCAPED_IN_SUBMARINE)
            && !F(FLAG_DEFEATED_MAGMA_SPACE_CENTER))
            return &sHoennSlateportHarbor;
        if (!F(FLAG_TEAM_AQUA_ESCAPED_IN_SUBMARINE) && !F(FLAG_DEFEATED_MAGMA_SPACE_CENTER))
            return &sHoennAquaHideout;
    }
    if (!B(REGION_HOENN, 6))
        return &sHoennTateLiza;
    if (!crisis)
    {
        if (!F(FLAG_DEFEATED_MAGMA_SPACE_CENTER))
            return &sHoennSpaceCenter;
        if (!F(FLAG_RECEIVED_HM_SURF) && !I(ITEM_HM_SURF))
            return &sHoennSurf;
        if (!F(FLAG_RECEIVED_HM_DIVE) && !I(ITEM_HM_DIVE))
            return &sHoennDive;
        if (!F(FLAG_RECEIVED_HM_ROCK_SMASH) && !I(ITEM_HM_ROCK_SMASH))
            return &sHoennRockSmash;
        if (!F(FLAG_RECEIVED_HM_STRENGTH) && !I(ITEM_HM_STRENGTH))
            return &sHoennStrength;
        return &sHoennSeafloor;
    }
    if (V(VAR_SOOTOPOLIS_CITY_STATE) < 6 && !F(FLAG_SOOTOPOLIS_ARCHIE_MAXIE_LEAVE))
    {
        if (V(VAR_SOOTOPOLIS_CITY_STATE) < 3 && !F(FLAG_WALLACE_GOES_TO_SKY_PILLAR))
            return F(FLAG_STEVEN_GUIDES_TO_CAVE_OF_ORIGIN) ? &sHoennOriginWallace : &sHoennSootopolisSteven;
        if (V(VAR_SOOTOPOLIS_CITY_STATE) < 5)
            return &sHoennSkyPillar;
        if (V(VAR_SKY_PILLAR_STATE) < 2 && V(VAR_SOOTOPOLIS_CITY_STATE) < 6)
            return &sHoennReturnSootopolis;
        return &sHoennSootopolisLeaders;
    }
    if (V(VAR_SOOTOPOLIS_CITY_STATE) < 6
        && !F(FLAG_RECEIVED_HM_WATERFALL) && !I(ITEM_HM_WATERFALL))
        return &sHoennWaterfall;
    if (!B(REGION_HOENN, 7))
        return &sHoennJuan;
    if (!F(FLAG_DEFEATED_WALLY_VICTORY_ROAD) && V(VAR_ELITE_4_STATE) == 0)
        return &sHoennVictoryRoad;
    return &sHoennLeague;
}

static const struct StoryObjective *ResolveHoennOptional(void)
{
    // A quest's acquired key or generator scene proves it actually started.
    // Owning the shared item alone does not advertise an unaccepted side quest.
    if (F(FLAG_GOT_TM_THUNDERBOLT_FROM_WATTSON))
        return NULL;
    if (V(VAR_NEW_MAUVILLE_STATE) == 2)
        return &sHoennNewMauvilleReward;
    if (F(FLAG_GOT_BASEMENT_KEY_FROM_WATTSON))
        return &sHoennNewMauville;
    return NULL;
}
